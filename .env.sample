# Copy this file to `.env` and fill in your keys.
# `.env` is gitignored; `.env.sample` is checked in.

# --- GitHub ---
# Used for authenticated GitHub requests (raises rate limits).
# Only "public_repo" scope is required for public content.
# Leave unset to make unauthenticated requests.
GITHUB_TOKEN=ghp_your_personal_access_token_here

# --- LLM providers ---
# Gemini is the primary provider; OpenAI is the fallback.
# Get a Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-free-trial-google-gemini-api-key-here

# Get an OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-free-trial-openai-api-key-here

# --- Search providers ---
# Brave Search (free tier: 2000 queries/month, 1 QPS). Used as a fallback
# when DuckDuckGo is unavailable. Get a key: https://api-dashboard.search.brave.com/
BRAVE_API_KEY=
